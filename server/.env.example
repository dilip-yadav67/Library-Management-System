# ---------- Server ----------
PORT=5000

# ---------- Database (MongoDB Atlas ki connection string yahan paste karein) ----------
MONGO_URI=

# ---------- Login security (koi bhi lambi random string yahan likhein) ----------
JWT_SECRET=

# ---------- Frontend ka address (local mein ye waisa hi rehne dein) ----------
CLIENT_URL=http://localhost:5173

# ---------- AI option 1: GEMINI (free) ----------
# Ye pehle use hota hai. Key yahan paste karein, bas = ke baad, bina space ke.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- AI option 2: CLAUDE (paid) ----------
# Ye tabhi chalega jab upar GEMINI_API_KEY khali ho.
# Abhi use nahi karna to ye line khali chhod dein.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5